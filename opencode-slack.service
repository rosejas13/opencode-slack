[Unit]
Description=opencode-slack bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rosejas
WorkingDirectory=/home/rosejas/Projects/opencode-slack
ExecStart=/home/rosejas/Projects/opencode-slack/node_modules/.bin/tsx src/app.ts
Restart=always
RestartSec=10
EnvironmentFile=/home/rosejas/Projects/opencode-slack/.env

[Install]
WantedBy=default.target
