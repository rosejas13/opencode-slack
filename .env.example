# Slack App credentials (from https://api.slack.com/apps)
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_APP_TOKEN=xapp-your-app-token-here
SLACK_SIGNING_SECRET=your-signing-secret-here

# Authorized Slack user ID (only this user can invoke the bot)
ALLOWED_USER_ID=U01ABCDEFGH

# opencode configuration
OPENCODE_PATH=/home/rosejas/.opencode/bin/opencode
OPENCODE_WORKDIR=/home/rosejas/Projects
OPENCODE_MODEL=
OPENCODE_AGENT=

# Response formatting
MAX_RESPONSE_LENGTH=3000
SHOW_THINKING=false
